<Page x:Class="LiveDJ.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="Black">

    <Grid>
        <!-- Background image -->
        <Image Source="ms-appx:///Assets/DriftAI.png"
               Stretch="Uniform"
               Opacity="0.6"/>
        <!-- Adjust opacity to taste -->

        <!-- Foreground content -->
        <Grid utu:SafeArea.Insets="VisibleBounds" Padding="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <utu:NavigationBar FontWeight="ExtraBold" FontSize="20" FontStretch="SemiCondensed" Content="{Binding Title}" Padding="10" Background="Transparent" Foreground="DeepSkyBlue"/>

            <StackPanel Grid.Row="1"
                        Spacing="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button HorizontalAlignment="Center" Background="Green" Content="Book Your DJ Slot" Click="GoToBooking"/>
                <Button HorizontalAlignment="Center" Background="Red" Content="Watch Stream" Click="GoToStream"/>
                
            </StackPanel>
        </Grid>

        <Button FontWeight="Normal" VerticalAlignment="Bottom" Background="Gold" Foreground="Black" HorizontalAlignment="Right"
                Margin="10" Content="Login" Click="GoToLogin"/>
        <Button FontWeight="Normal" VerticalAlignment="Bottom" Background="MediumSpringGreen" Foreground="Black" 
                Margin="10" Content="DJ Sign Up" Click="GoToSignup"/>
    </Grid>
</Page>
