<Page x:Class="LiveDJ.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="Black">

    <Grid>
        <!-- Background image -->
        <Image Source="ms-appx:///Assets/DriftAI.png"
               Stretch="Uniform"
               Opacity="0.6"/>
        <!-- Adjust opacity to taste -->

        <!-- Foreground content -->
        <Grid utu:SafeArea.Insets="VisibleBounds" Padding="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <utu:NavigationBar FontWeight="ExtraBold" FontSize="20" FontStretch="SemiCondensed" Content="{Binding Title}" Padding="8" Background="Transparent" Foreground="DeepSkyBlue"/>

            <StackPanel Spacing="10" Padding="12" Margin="8,8,0,0">
                <TextBlock Text="Browse DJs" FontWeight="SemiBold"/>
                <ComboBox Margin="20" VerticalAlignment="Center" x:Name="DjPicker"
                          ItemsSource="{Binding Djs}"
                          DisplayMemberPath="Display"
                          PlaceholderText="Select a DJ…"
                          SelectionChanged="OnDjPicked"/>
            </StackPanel>
            
            <StackPanel Grid.Row="1"
                        Spacing="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button HorizontalAlignment="Center" Background="Green" Content="Book Your DJ Slot" Click="GoToBooking"/>
                <Button HorizontalAlignment="Center" Background="OrangeRed" Content="Watch Stream" Click="GoToStream"/>
                
            </StackPanel>
        </Grid>

        <Button Margin="10" VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="Red" Foreground="Black" Content="DJ Dash" Click="GoToDashboard" />

        <Button FontWeight="Normal" VerticalAlignment="Bottom" Background="Gold" Foreground="Black" HorizontalAlignment="Center"
                Margin="10" Content="Login" Click="GoToLogin"/>
        <Button FontWeight="Normal" VerticalAlignment="Bottom" Background="MediumSpringGreen" Foreground="Black" 
                Margin="10" Content="DJ Sign Up" Click="GoToSignup"/>
    </Grid>
</Page>
