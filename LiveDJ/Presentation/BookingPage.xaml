<Page
    x:Class="LiveDJ.Presentation.BookingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utu="using:Uno.Toolkit.UI"
    Background="Transparent">

    <Grid>
        <Image Source="ms-appx:///Assets/ClubSET.png"
               Stretch="UniformToFill"
               Opacity="2"/>

        <ScrollViewer>
            <StackPanel MaxWidth="880" Margin="16" Spacing="14">

                <utu:NavigationBar Content="Book a DJ"
                                   Background="Transparent"
                                   Foreground="White" />

                <!-- DJ picker -->
                <StackPanel Spacing="6">
                    <TextBlock HorizontalAlignment="Center" Text="Select a DJ" Foreground="White" FontWeight="SemiBold"/>
                    <ComboBox x:Name="DjPicker"
                              ItemsSource="{Binding Djs}"
                              DisplayMemberPath="Display"
                              PlaceholderText="Choose a DJ…"
                              SelectionChanged="OnDjPicked"/>
                </StackPanel>

                <!-- Availability -->
                <Grid ColumnDefinitions="2*,*" ColumnSpacing="16" RowSpacing="8">

                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Text="Availability Calendar"
                                   FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <CalendarView HorizontalAlignment="Center" x:Name="AvailCalendar"
                                      SelectionMode="Single"
                                      CalendarViewDayItemChanging="OnCalendarDayItemChanging"
                                      SelectedDatesChanged="OnSelectedDateChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Available Slots" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6"/>
                        <ItemsControl x:Name="SlotsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#22000000" CornerRadius="8" Padding="10" Margin="0,4">
                                        <TextBlock Text="{Binding}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
