<Page
x:Class="LiveDJ.Presentation.BookingPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <ScrollViewer>
            <StackPanel Spacing="16" Padding="24" MaxWidth="800">
                <TextBlock Margin="20" Text="Book a Live Set" FontSize="28" FontWeight="Bold"/>

                <!-- Date & Time -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <StackPanel Width="220">
                        <TextBlock Text="Event Date"/>
                        <CalendarDatePicker x:Name="DatePicker" DateChanged="OnDateChanged"/>
                    </StackPanel>
                    <StackPanel Width="150">
                        <TextBlock Text="Start Time"/>
                        <TimePicker Margin="7" VerticalAlignment="Top" x:Name="TimePicker" Padding="-5" TimeChanged="OnTimeChanged"/>
                    </StackPanel>
                    <StackPanel Width="160">
                        <TextBlock Text="Duration"/>
                        <ComboBox x:Name="DurationBox">
                            <ComboBoxItem Content="2 Hours" Tag="2"/>
                            <ComboBoxItem Content="4 Hours" Tag="4"/>
                            <ComboBoxItem Content="6 Hours" Tag="6"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <!-- DJ selector -->
                <StackPanel>
                    <TextBlock Text="Choose a DJ"/>
                    <ComboBox x:Name="DjBox" PlaceholderText="Select DJ" SelectionChanged="OnDjChanged"/>
                </StackPanel>

                <!-- Price preview (optional) -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Estimated Price:"/>
                    <TextBlock x:Name="PriceText" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Availability -->
                <Border Background="#11000000" Padding="12" CornerRadius="6">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Availability" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AvailabilityText" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Errors -->
                <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap"/>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Reserve (Pay Now)" Click="OnCheckout"/>
                    <Button Content="Refresh Availability" Click="OnRefreshAvailability"/>
                    
                </StackPanel>
                <Button Content="Cancel" Click="OnCancel" Background="Red"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
