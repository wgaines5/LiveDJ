<Page
x:Class="LiveDJ.Presentation.DashboardPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Grid>
        <ScrollViewer>
            <StackPanel Spacing="18" Padding="24" MaxWidth="820">
                <TextBlock Text="DJ Dashboard" FontSize="28" FontWeight="Bold"/>


                <!-- Payout Method -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Payment Method" FontWeight="SemiBold"/>
                    <ComboBox x:Name="PaymentMethodBox" SelectionChanged="OnPaymentMethodChanged">
                        <ComboBoxItem Content="Stripe" Tag="stripe"/>
                        <ComboBoxItem Content="PayPal" Tag="paypal"/>
                    </ComboBox>
                </StackPanel>


                <!-- Stripe Connect -->
                <Border x:Name="StripePanel" Visibility="Collapsed" Background="#0A000000" Padding="12" CornerRadius="6">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Stripe Connect" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Connect / Update Stripe" Click="OnConnectStripe"/>
                            <Button Content="Refresh Status" Click="OnRefreshStripeStatus"/>
                        </StackPanel>
                        <TextBlock x:Name="StripeStatusText" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>


                <!-- PayPal Setup -->
                <Border x:Name="PaypalPanel" Visibility="Collapsed" Background="#0A000000" Padding="12" CornerRadius="6">
                    <StackPanel Spacing="8">
                        <TextBlock Text="PayPal" FontWeight="SemiBold"/>
                        <TextBox x:Name="PaypalEmailBox" PlaceholderText="PayPal Email"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Save PayPal" Click="OnSavePaypal"/>
                            <Button Content="Remove PayPal" Click="OnRemovePaypal"/>
                        </StackPanel>
                        <TextBlock x:Name="PaypalStatusText" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                
                <!-- Set Availability-->
                <StackPanel Spacing="8" Margin="0,20,0,0">
                    <TextBlock Text="Set Availability" FontWeight="SemiBold"/>
                    <CalendarView x:Name="AvailabilityCalendar" SelectionMode="Multiple"/>
                    <TextBlock Text="Available Hours"/>
                    <StackPanel Orientation="Vertical" Spacing="8">
                        <TimePicker x:Name="StartHourPicker"/>
                        <TextBlock Text="to"/>
                        <TimePicker x:Name="EndHourPicker"/>
                    </StackPanel>
                    <Button Content="Save Availability" Click="OnSaveAvailability"/>
                </StackPanel>

                <!-- Pricing -->
                <StackPanel Spacing="8" Margin="0,20,0,0">
                    <TextBlock Text="Set Pricing" FontWeight="SemiBold"/>
                    <TextBox x:Name="HourlyRateBox" PlaceholderText="Hourly Rate (USD)" />
                    <TextBox x:Name="MinHoursBox" PlaceholderText="Minimum Hours" />
                    <Button Content="Save Pricing" Click="OnSavePricing"/>
                </StackPanel>

                <!-- Alerts / Errors -->
                <TextBlock x:Name="DashErrorText" Foreground="Red" TextWrapping="Wrap"/>

                <Button Content="Cancel" Click="OnCancel" Background="Red" Margin="0,20,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
