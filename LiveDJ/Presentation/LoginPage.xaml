<Page
x:Class="LiveDJ.Presentation.LoginPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:utu="using:Uno.Toolkit.UI"
Background="Transparent">


    <Grid>
        <!-- Optional background -->
        <Image Source="ms-appx:///Assets/DriftAI.png" Stretch="UniformToFill" Opacity="0.25"/>


        <StackPanel MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Padding="24">
            <TextBlock Text="LiveDJ Login" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>


            <TextBox x:Name="EmailBox" PlaceholderText="Email" InputScope="EmailSmtpAddress"/>
            <PasswordBox x:Name="PasswordBox" PlaceholderText="Password"/>


            <Button Content="Sign In" Click="OnSignIn"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>

            <Button Content="Cancel" Click="OnCancel" />


            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <HyperlinkButton Content="Forgot Password?" Click="OnForgot"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
